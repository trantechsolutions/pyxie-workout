{
  "name": "pyxie",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "export:sprites": "vite-node scripts/export-sprites.ts",
    "verify:sprites": "npm run export:sprites && git diff --exit-code docs/wiki/sprites/"
  },
  "dependencies": {
    "@clerk/backend": "^1.21.0",
    "@clerk/clerk-react": "^5.20.0",
    "@neondatabase/serverless": "^0.10.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@vercel/node": "^5.1.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-node": "^2.1.9",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
